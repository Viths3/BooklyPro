NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://booklypro:booklypro_local@localhost:5432/booklypro

# Generate independent random secrets (at least 32 characters each).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Step between candidate starts, in minutes (1-1440).
AVAILABILITY_SLOT_INTERVAL_MINUTES=15

# Exact browser origins separated by commas; empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173
# Local: 0. Railway public ingress: 1; reassess when adding other proxies.
TRUST_PROXY_HOPS=0

# Optional as a complete group: omit/leave all empty to disable image uploads.
# Backend only. Never place the API secret in VITE_* variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
